{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zdp:money:account-payments:v1",
  "title": "Private account payment history",
  "x-zdp-transport": {
    "status": "default-disabled",
    "method": "GET",
    "path": "/v1/account/payments",
    "query": [
      "cursor"
    ],
    "sessionHeader": "x-zdp-account-session",
    "maxResponseBytes": 131072,
    "cacheControl": "no-store",
    "rejections": {
      "400": "invalid_request",
      "401": "authentication_failed",
      "503": "payments_unavailable"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "money.account-payments.v1"
    },
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pay_[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "occurred_at",
        "currency",
        "amount_minor",
        "tax_minor",
        "refunded_minor",
        "payment_method",
        "payment_status",
        "fulfillment_status",
        "quantity",
        "quantity_unit",
        "receipt_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pay_[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "lemon_topup",
            "lemon_auto_topup",
            "doubloon_purchase"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "currency": {
          "const": "USD"
        },
        "amount_minor": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "tax_minor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "refunded_minor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "payment_method": {
          "enum": [
            "card",
            "bank",
            "wallet",
            "crypto_invoice",
            "manual_provider_reference"
          ]
        },
        "payment_status": {
          "enum": [
            "pending",
            "paid",
            "failed",
            "cancelled",
            "expired",
            "review_required",
            "partially_refunded",
            "refunded"
          ]
        },
        "fulfillment_status": {
          "enum": [
            "pending",
            "fulfilled",
            "failed",
            "review_required",
            "unconfirmed"
          ]
        },
        "quantity": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "quantity_unit": {
          "enum": [
            "credit_unit",
            "doubloon"
          ]
        },
        "receipt_url": {
          "type": "null"
        }
      }
    }
  }
}
